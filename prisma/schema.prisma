generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  agency_owner
  agency_staff
  client_admin
  client_staff
  read_only
}

enum QuoteFlowStatus {
  draft
  active
  archived
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  role         Role            @default(agency_staff)
  passwordHash String
  createdAt    DateTime        @default(now())
  workspaces   WorkspaceUser[]
}

model Agency {
  id         String      @id @default(cuid())
  name       String
  createdAt  DateTime    @default(now())
  workspaces Workspace[]
}

model Workspace {
  id         String          @id @default(cuid())
  agencyId   String
  agency     Agency          @relation(fields: [agencyId], references: [id])
  name       String
  slug       String          @unique
  createdAt  DateTime        @default(now())
  users      WorkspaceUser[]
  quoteFlows QuoteFlow[]
}

model WorkspaceUser {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  role        Role      @default(client_staff)

  @@unique([workspaceId, userId])
}

model QuoteFlow {
  id                 String            @id @default(cuid())
  workspaceId        String
  workspace          Workspace         @relation(fields: [workspaceId], references: [id])
  name               String
  status             QuoteFlowStatus   @default(draft)
  publishedVersionId String?
  createdAt          DateTime          @default(now())
  versions           QuoteFlowVersion[]
  sessions           QuoteSession[]
  submissions        Submission[]
}

model QuoteFlowVersion {
  id            String    @id @default(cuid())
  quoteFlowId   String
  quoteFlow     QuoteFlow @relation(fields: [quoteFlowId], references: [id])
  versionNumber Int
  configJson    Json
  createdAt     DateTime  @default(now())
}

model QuoteSession {
  id          String   @id @default(cuid())
  flowId      String
  flow        QuoteFlow @relation(fields: [flowId], references: [id])
  versionId   String
  answersJson Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Submission {
  id           String   @id @default(cuid())
  flowId       String
  flow         QuoteFlow @relation(fields: [flowId], references: [id])
  versionId    String
  contactJson  Json
  answersJson  Json
  resultJson   Json
  needsReview  Boolean  @default(false)
  createdAt    DateTime @default(now())
}
