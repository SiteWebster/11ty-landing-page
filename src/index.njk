---
layout: base.njk
isFront: true
---

{% include "navbar.njk" %}

<!-- ═══════════════════════════════════════════════════════
     HERO SECTION
══════════════════════════════════════════════════════════ -->
<section class="hero-section" style="min-height: 560px;">
  <div class="max-w-7xl mx-auto px-4 py-16 flex flex-col lg:flex-row items-center gap-10">

    <!-- Left: Text -->
    <div class="flex-1 z-10">
      <h1 class="font-heading font-black text-white uppercase leading-tight mb-4" style="font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 1.05;">
        Handyman Help That<br>
        <span class="text-orange-500">Actually</span><br>
        Shows Up
      </h1>
      <p class="text-gray-300 text-base leading-relaxed mb-8 max-w-lg">
        Reliable. Skilled. No excuses. From quick fixes to full-on projects, we tackle the jobs other guys avoid—so you don't have to.
      </p>
      <a href="#contact" class="btn-orange text-white no-underline">
        Book A Repair
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Right: Hero Illustration -->
    <div class="flex-1 flex justify-center items-end relative" style="min-height: 360px;">
      <!-- Decorative orange splash -->
      <div style="position:absolute; top:0; right:0; width:320px; height:320px; background: radial-gradient(circle, rgba(232,96,10,0.18) 0%, transparent 70%); border-radius:50%;"></div>
      <!-- Handyman figure placeholder -->
      <div style="position:relative; z-index:2; text-align:center;">
        <svg viewBox="0 0 280 380" width="280" height="380" xmlns="http://www.w3.org/2000/svg">
          <!-- Shadow -->
          <ellipse cx="140" cy="370" rx="90" ry="12" fill="rgba(0,0,0,0.4)"/>
          <!-- Body -->
          <rect x="90" y="180" width="100" height="140" rx="8" fill="#1a1a1a"/>
          <!-- Head -->
          <circle cx="140" cy="155" r="38" fill="#c8956c"/>
          <!-- Cap -->
          <path d="M102 148 Q140 108 178 148 L178 148 Q178 130 140 124 Q102 130 102 148Z" fill="#111111"/>
          <rect x="95" y="146" width="90" height="8" rx="4" fill="#111111"/>
          <!-- Face features -->
          <circle cx="128" cy="152" r="4" fill="#2a1a0a"/>
          <circle cx="152" cy="152" r="4" fill="#2a1a0a"/>
          <path d="M128 168 Q140 176 152 168" stroke="#2a1a0a" stroke-width="2" fill="none" stroke-linecap="round"/>
          <!-- Beard -->
          <path d="M110 162 Q140 182 170 162 Q165 178 140 180 Q115 178 110 162Z" fill="#8a6a4a"/>
          <!-- Arms -->
          <rect x="50" y="185" width="42" height="22" rx="11" fill="#1a1a1a" transform="rotate(15 50 185)"/>
          <rect x="188" y="185" width="42" height="22" rx="11" fill="#1a1a1a" transform="rotate(-15 230 185)"/>
          <!-- Hands -->
          <circle cx="52" cy="210" r="14" fill="#c8956c"/>
          <circle cx="228" cy="210" r="14" fill="#c8956c"/>
          <!-- Drill in right hand -->
          <rect x="218" y="200" width="36" height="14" rx="4" fill="#E8600A"/>
          <rect x="248" y="207" width="20" height="6" rx="2" fill="#666"/>
          <rect x="232" y="213" width="8" height="20" rx="2" fill="#E8600A"/>
          <!-- Tool belt -->
          <rect x="88" y="278" width="104" height="18" rx="4" fill="#5a3a1a"/>
          <rect x="108" y="280" width="18" height="14" rx="2" fill="#E8600A"/>
          <rect x="134" y="280" width="18" height="14" rx="2" fill="#E8600A"/>
          <rect x="160" y="280" width="18" height="14" rx="2" fill="#E8600A"/>
          <!-- Legs -->
          <rect x="102" y="315" width="34" height="55" rx="6" fill="#1a1a1a"/>
          <rect x="144" y="315" width="34" height="55" rx="6" fill="#1a1a1a"/>
          <!-- Boots -->
          <rect x="98" y="358" width="44" height="18" rx="4" fill="#222"/>
          <rect x="140" y="358" width="44" height="18" rx="4" fill="#222"/>
          <!-- Shirt logo -->
          <text x="140" y="245" text-anchor="middle" fill="#E8600A" font-size="9" font-weight="bold" font-family="Arial">BTYH</text>
        </svg>
      </div>
    </div>
  </div>

  <!-- Bottom orange accent bar -->
  <div style="height:4px; background: linear-gradient(to right, transparent, #E8600A 30%, #E8600A 70%, transparent);"></div>
</section>


<!-- ═══════════════════════════════════════════════════════
     TRUST BAR
══════════════════════════════════════════════════════════ -->
<section class="trust-bar bg-white py-8">
  <div class="max-w-5xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <div class="flex items-center gap-4">
        <div class="flex-shrink-0 w-14 h-14 rounded-full border-2 border-orange-500 flex items-center justify-center">
          <svg class="w-7 h-7 text-orange-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <div>
          <div class="font-heading font-bold text-gray-900 uppercase tracking-wide text-sm">Trusted &amp; Reliable</div>
          <div class="text-gray-500 text-xs mt-1">On time. Every time.</div>
        </div>
      </div>

      <div class="flex items-center gap-4 md:justify-center">
        <div class="flex-shrink-0 w-14 h-14 rounded-full border-2 border-orange-500 flex items-center justify-center">
          <svg class="w-7 h-7 text-orange-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <div>
          <div class="font-heading font-bold text-gray-900 uppercase tracking-wide text-sm">Skilled Professionals</div>
          <div class="text-gray-500 text-xs mt-1">Quality work that lasts.</div>
        </div>
      </div>

      <div class="flex items-center gap-4 md:justify-end">
        <div class="flex-shrink-0 w-14 h-14 rounded-full border-2 border-orange-500 flex items-center justify-center">
          <svg class="w-7 h-7 text-orange-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"/>
          </svg>
        </div>
        <div>
          <div class="font-heading font-bold text-gray-900 uppercase tracking-wide text-sm">Satisfaction Guaranteed</div>
          <div class="text-gray-500 text-xs mt-1">We're not done until you're happy.</div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     ABOUT SECTION
══════════════════════════════════════════════════════════ -->
<section class="bg-white py-20" id="about">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex flex-col lg:flex-row gap-12 items-center">

      <!-- Text -->
      <div class="flex-1">
        <h2 class="font-heading font-black text-gray-900 uppercase leading-tight mb-4" style="font-size: clamp(2rem, 4vw, 3rem);">
          Better Than Your<br>Average <span class="text-orange-500">Handyman</span>
        </h2>
        <span class="orange-rule mb-6 block"></span>
        <p class="text-gray-600 leading-relaxed mb-4">
          We're the go-to crew for homeowners who are done waiting, done worrying, and done patching things themselves.
        </p>
        <p class="text-gray-600 leading-relaxed mb-8">
          Big or small, simple or complicated—if it needs fixing, building, mounting, or maintaining, we've got the tools and the attitude to get it done right.
        </p>
        <a href="#contact" class="btn-outline-white" style="color:#111; border-color:#111;">
          Learn More About Us
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Image -->
      <div class="flex-1 relative" style="min-height: 320px;">
        <div class="w-full h-72 lg:h-96 overflow-hidden" style="border: 4px solid #111; position:relative;">
          <!-- Tool wall image placeholder -->
          <div style="width:100%; height:100%; background: linear-gradient(135deg, #3a2a1a 0%, #2a1a0a 60%, #1a0a00 100%); display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden;">
            <!-- Tool rack illustration -->
            <svg viewBox="0 0 400 300" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" style="position:absolute;inset:0;">
              <!-- Wood background -->
              <rect width="400" height="300" fill="#3a2010"/>
              <line x1="0" y1="50" x2="400" y2="50" stroke="#2a1508" stroke-width="1" stroke-dasharray="3,2"/>
              <line x1="0" y1="100" x2="400" y2="100" stroke="#2a1508" stroke-width="1" stroke-dasharray="3,2"/>
              <line x1="0" y1="150" x2="400" y2="150" stroke="#2a1508" stroke-width="1" stroke-dasharray="3,2"/>
              <line x1="0" y1="200" x2="400" y2="200" stroke="#2a1508" stroke-width="1" stroke-dasharray="3,2"/>
              <line x1="0" y1="250" x2="400" y2="250" stroke="#2a1508" stroke-width="1" stroke-dasharray="3,2"/>
              <!-- Hammer -->
              <rect x="60" y="60" width="12" height="70" rx="4" fill="#8B6A3E"/>
              <rect x="44" y="55" width="44" height="22" rx="4" fill="#888"/>
              <!-- Screwdriver -->
              <rect x="130" y="50" width="8" height="80" rx="3" fill="#E8600A"/>
              <rect x="127" y="127" width="14" height="20" rx="2" fill="#888"/>
              <rect x="131" y="147" width="6" height="30" rx="1" fill="#ccc"/>
              <!-- Wrench -->
              <path d="M190 55 Q200 65 195 80 L192 140 Q190 145 188 140 L185 80 Q180 65 190 55Z" fill="#666"/>
              <circle cx="190" cy="60" r="12" fill="none" stroke="#666" stroke-width="8"/>
              <!-- Tape measure -->
              <rect x="240" y="70" width="50" height="40" rx="8" fill="#E8600A"/>
              <circle cx="265" cy="90" r="10" fill="#ffcc00" stroke="#E8600A" stroke-width="2"/>
              <!-- Level -->
              <rect x="40" y="180" width="160" height="24" rx="4" fill="#f5c842"/>
              <circle cx="120" cy="192" r="8" fill="none" stroke="#888" stroke-width="2"/>
              <circle cx="120" cy="192" r="3" fill="#888"/>
              <!-- Drill -->
              <rect x="260" y="170" width="80" height="30" rx="8" fill="#E8600A"/>
              <rect x="278" y="198" width="20" height="30" rx="4" fill="#E8600A"/>
              <rect x="334" y="177" width="30" height="10" rx="4" fill="#666"/>
              <rect x="362" y="180" width="20" height="4" rx="1" fill="#888"/>
            </svg>
          </div>
          <!-- Orange corner accent -->
          <div style="position:absolute; top:0; right:0; width:0; height:0; border-style:solid; border-width:0 40px 40px 0; border-color:transparent #E8600A transparent transparent;"></div>
        </div>
        <!-- Decorative offset border -->
        <div style="position:absolute; bottom:-12px; right:-12px; width:100%; height:100%; border:3px solid #E8600A; z-index:-1;"></div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     SERVICES SECTION
══════════════════════════════════════════════════════════ -->
<section class="bg-dark py-20" id="services">
  <div class="max-w-6xl mx-auto px-4">

    <div class="text-center mb-12">
      <div class="section-arrow-title text-white text-3xl mb-3">
        <svg width="32" height="16" viewBox="0 0 32 16" fill="none"><polygon points="0,8 10,0 10,6 32,6 32,10 10,10 10,16" fill="#E8600A"/></svg>
        <span class="font-heading font-black text-white uppercase" style="font-size:2rem; letter-spacing:.12em;">Our Services</span>
        <svg width="32" height="16" viewBox="0 0 32 16" fill="none"><polygon points="32,8 22,0 22,6 0,6 0,10 22,10 22,16" fill="#E8600A"/></svg>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">

      <!-- TV Mounting -->
      <div class="service-card text-center pb-6">
        <div class="service-img img-placeholder-2 flex items-center justify-center">
          <svg viewBox="0 0 120 90" width="120" height="90" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="10" y="10" width="100" height="60" rx="4" fill="#222" stroke="#444" stroke-width="2"/>
            <rect x="16" y="16" width="88" height="48" rx="2" fill="#1a3a5a"/>
            <rect x="50" y="70" width="20" height="8" fill="#333"/>
            <rect x="35" y="76" width="50" height="4" rx="2" fill="#333"/>
            <!-- Screen content -->
            <rect x="20" y="20" width="80" height="40" rx="1" fill="#0a2040"/>
            <circle cx="60" cy="40" r="12" fill="#E8600A" opacity="0.8"/>
            <polygon points="57,34 57,46 68,40" fill="white"/>
          </svg>
        </div>
        <div style="position:relative; height:26px;">
          <div class="service-icon-badge">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
        </div>
        <div class="pt-8 px-4">
          <h3 class="font-heading font-bold text-white uppercase tracking-wide text-base mb-2">TV Mounting</h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-4">Secure, level, and clean installations for any size TV.</p>
          <a href="#contact" class="text-orange-500 text-xs font-bold uppercase tracking-wider no-underline hover:text-orange-400">
            Learn More ›
          </a>
        </div>
      </div>

      <!-- Carpentry -->
      <div class="service-card text-center pb-6">
        <div class="service-img img-placeholder-3 flex items-center justify-center">
          <svg viewBox="0 0 120 90" width="120" height="90" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Door frame -->
            <rect x="25" y="15" width="70" height="70" rx="2" fill="#5a3a1a"/>
            <rect x="28" y="18" width="64" height="64" rx="1" fill="#3a2010"/>
            <rect x="32" y="22" width="26" height="56" fill="#6a4a22"/>
            <rect x="62" y="22" width="26" height="56" fill="#6a4a22"/>
            <circle cx="62" cy="52" r="3" fill="#E8600A"/>
            <!-- Wood grain lines -->
            <line x1="35" y1="30" x2="55" y2="30" stroke="#5a3a1a" stroke-width="1"/>
            <line x1="35" y1="40" x2="55" y2="40" stroke="#5a3a1a" stroke-width="1"/>
            <line x1="35" y1="50" x2="55" y2="50" stroke="#5a3a1a" stroke-width="1"/>
          </svg>
        </div>
        <div style="position:relative; height:26px;">
          <div class="service-icon-badge">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
        </div>
        <div class="pt-8 px-4">
          <h3 class="font-heading font-bold text-white uppercase tracking-wide text-base mb-2">Carpentry</h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-4">Trim, doors, shelves, and custom woodwork built to last.</p>
          <a href="#contact" class="text-orange-500 text-xs font-bold uppercase tracking-wider no-underline hover:text-orange-400">
            Learn More ›
          </a>
        </div>
      </div>

      <!-- Drywall Repair -->
      <div class="service-card text-center pb-6">
        <div class="service-img img-placeholder-1 flex items-center justify-center">
          <svg viewBox="0 0 120 90" width="120" height="90" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Wall with patch -->
            <rect x="10" y="10" width="100" height="70" fill="#e8e0d0"/>
            <!-- Hole/crack -->
            <path d="M50 35 L60 28 L65 40 L75 33 L70 50 L60 45 L55 58 L45 50 L48 40 Z" fill="#bbb" stroke="#999" stroke-width="1"/>
            <!-- Patch/spackle -->
            <ellipse cx="60" cy="42" rx="22" ry="18" fill="#f0ece0" stroke="#ddd" stroke-width="1"/>
            <!-- Putty knife -->
            <rect x="80" y="55" width="8" height="30" rx="2" fill="#888" transform="rotate(-30 80 55)"/>
            <rect x="70" y="62" width="18" height="8" rx="2" fill="#E8600A" transform="rotate(-30 80 55)"/>
          </svg>
        </div>
        <div style="position:relative; height:26px;">
          <div class="service-icon-badge">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </div>
        </div>
        <div class="pt-8 px-4">
          <h3 class="font-heading font-bold text-white uppercase tracking-wide text-base mb-2">Drywall Repair</h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-4">Patches, holes, and smooth finishes—like it never happened.</p>
          <a href="#contact" class="text-orange-500 text-xs font-bold uppercase tracking-wider no-underline hover:text-orange-400">
            Learn More ›
          </a>
        </div>
      </div>

      <!-- Plumbing Fixes -->
      <div class="service-card text-center pb-6">
        <div class="service-img img-placeholder-4 flex items-center justify-center">
          <svg viewBox="0 0 120 90" width="120" height="90" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Under sink pipes -->
            <rect x="20" y="10" width="80" height="50" rx="3" fill="#2a3a4a"/>
            <rect x="22" y="12" width="76" height="46" rx="2" fill="#1a2a3a"/>
            <!-- Faucet -->
            <rect x="52" y="12" width="16" height="8" rx="2" fill="#888"/>
            <rect x="58" y="20" width="4" height="10" fill="#888"/>
            <!-- Water drops -->
            <ellipse cx="60" cy="35" rx="3" ry="5" fill="#4af" opacity="0.8"/>
            <!-- Pipe wrench -->
            <rect x="75" y="40" width="10" height="35" rx="3" fill="#E8600A"/>
            <path d="M73 38 Q78 32 85 38 L83 42 Q78 38 73 42 Z" fill="#E8600A"/>
          </svg>
        </div>
        <div style="position:relative; height:26px;">
          <div class="service-icon-badge">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
            </svg>
          </div>
        </div>
        <div class="pt-8 px-4">
          <h3 class="font-heading font-bold text-white uppercase tracking-wide text-base mb-2">Plumbing Fixes</h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-4">Fixing leaks, swaps, and small repairs done right.</p>
          <a href="#contact" class="text-orange-500 text-xs font-bold uppercase tracking-wider no-underline hover:text-orange-400">
            Learn More ›
          </a>
        </div>
      </div>

    </div>

    <div class="text-center">
      <a href="#contact" class="btn-orange no-underline">
        View All Services
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     WHY CHOOSE US
══════════════════════════════════════════════════════════ -->
<section class="bg-white py-20">
  <div class="max-w-6xl mx-auto px-4">

    <div class="text-center mb-12">
      <div class="flex items-center justify-center gap-3 mb-3">
        <svg width="32" height="16" viewBox="0 0 32 16" fill="none"><polygon points="0,8 10,0 10,6 32,6 32,10 10,10 10,16" fill="#E8600A"/></svg>
        <h2 class="font-heading font-black text-gray-900 uppercase" style="font-size:2rem; letter-spacing:.12em;">Why Choose <span class="text-orange-500">Us?</span></h2>
        <svg width="32" height="16" viewBox="0 0 32 16" fill="none"><polygon points="32,8 22,0 22,6 0,6 0,10 22,10 22,16" fill="#E8600A"/></svg>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 text-center">

      <div>
